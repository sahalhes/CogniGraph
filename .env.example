# Server-only settings. Never prefix API keys with VITE_.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Docker Neo4j, or replace with a neo4j+s:// Aura URI.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-local-password
NEO4J_DATABASE=neo4j

# Optional: enable YouTube Data API v3 in Google Cloud and supply its key.
YOUTUBE_API_KEY=

# Keep this stable so returning browsers retain their personal workspace.
# Generate a value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001

# Set NODE_ENV=production when using npm start after npm run build.
# In production APP_ORIGIN must be the public HTTPS origin and HOST may be 0.0.0.0.



# Use openrouter with OPENROUTER_API_KEY; otherwise gemini.
# AI_PROVIDER=openrouter
